#!/usr/bin/env python3
"""
Test script to verify the Vehicle Number Plate Detection setup
Run this before starting the main application to check if everything is working
"""

import sys
import subprocess

def check_python_version():
    """Check if Python version is compatible"""
    print("🐍 Checking Python version...")
    version = sys.version_info
    if version.major >= 3 and version.minor >= 8:
        print(f"   ✅ Python {version.major}.{version.minor}.{version.micro} - Compatible")
        return True
    else:
        print(f"   ❌ Python {version.major}.{version.minor}.{version.micro} - Requires Python 3.8+")
        return False

def check_dependencies():
    """Check if required packages are installed"""
    print("\n📦 Checking dependencies...")
    
    required_packages = [
        ('flask', 'Flask'),
        ('cv2', 'OpenCV'),
        ('numpy', 'NumPy'),
        ('imutils', 'imutils'),
        ('easyocr', 'EasyOCR'),
        ('torch', 'PyTorch'),
    ]
    
    all_installed = True
    for package, name in required_packages:
        try:
            __import__(package)
            print(f"   ✅ {name} - Installed")
        except ImportError:
            print(f"   ❌ {name} - Not installed")
            all_installed = False
    
    return all_installed

def check_camera():
    """Check if camera is available"""
    print("\n📷 Checking camera...")
    try:
        import cv2
        cap = cv2.VideoCapture(0)
        if cap.isOpened():
            print("   ✅ Camera detected and accessible")
            cap.release()
            return True
        else:
            print("   ⚠️  Camera detected but not accessible (may be in use)")
            return False
    except Exception as e:
        print(f"   ❌ Camera check failed: {e}")
        return False

def check_files():
    """Check if required files exist"""
    print("\n📁 Checking project files...")
    
    required_files = [
        'app.py',
        'requirements.txt',
        'templates/index.html',
        'static/style.css',
        'static/script.js',
    ]
    
    import os
    all_exist = True
    
    for file in required_files:
        if os.path.exists(file):
            print(f"   ✅ {file}")
        else:
            print(f"   ❌ {file} - Missing")
            all_exist = False
    
    return all_exist

def main():
    """Run all checks"""
    print("=" * 60)
    print("🚗 Vehicle Number Plate Detection - Setup Test")
    print("=" * 60)
    
    results = {
        'Python': check_python_version(),
        'Dependencies': check_dependencies(),
        'Camera': check_camera(),
        'Files': check_files(),
    }
    
    print("\n" + "=" * 60)
    print("📊 Test Results Summary")
    print("=" * 60)
    
    passed = sum(results.values())
    total = len(results)
    
    for check, result in results.items():
        status = "✅ PASS" if result else "❌ FAIL"
        print(f"   {check}: {status}")
    
    print(f"\n   Total: {passed}/{total} checks passed")
    
    if passed == total:
        print("\n🎉 All checks passed! You can now run the application:")
        print("   python app.py")
        print("\n   Then open http://localhost:5000 in your browser")
        return 0
    else:
        print("\n⚠️  Some checks failed. Please resolve the issues above.")
        return 1

if __name__ == "__main__":
    sys.exit(main())
